datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String?          
  provider    String   @default("local")
  providerId  String?
  loginStreak Int      @default(0)
  lastLoginAt DateTime?
  streakDisabled Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomsOwned  Room[]       @relation("UserOwnedRooms")
  roomMembers RoomMember[]
  attendance  RoomAttendance[]
  communityPosts   CommunityPost[]
  communityReplies CommunityReply[]
  profile UserProfile?
  focusSessions    FocusSession[]

  createdCohorts    Cohort[]         @relation("UserCreatedCohorts")
  cohortMemberships CohortMember[]   @relation("UserCohorts")
  discussions       DiscussionPost[] @relation("UserDiscussions")
  quizAttempts      QuizAttempt[]    @relation("UserQuizAttempts")

  friendRequestsSent     Friendship[] @relation("FriendRequestsSent")
  friendRequestsReceived Friendship[] @relation("FriendRequestsReceived")

  dmSent     DirectMessage[] @relation("DmSent")
  dmReceived DirectMessage[] @relation("DmReceived")

  @@unique([provider, providerId])
}

model DirectMessage {
  id          String    @id @default(cuid())
  senderId    String
  recipientId String
  text        String
  roomId      String? // set when the message is a room invite
  mediaUrl    String? // set for shared media
  mediaType   String? // "image" | "file"
  fileName    String? // original filename for non-image media
  createdAt   DateTime  @default(now())
  readAt      DateTime?

  sender    User @relation("DmSent", fields: [senderId], references: [id], onDelete: Cascade)
  recipient User @relation("DmReceived", fields: [recipientId], references: [id], onDelete: Cascade)

  @@index([senderId, recipientId, createdAt])
  @@index([recipientId, readAt])
}

model Friendship {
  id          String    @id @default(cuid())
  requesterId String
  addresseeId String
  status      String    @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime  @default(now())
  respondedAt DateTime?

  requester User @relation("FriendRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  addressee User @relation("FriendRequestsReceived", fields: [addresseeId], references: [id], onDelete: Cascade)

  @@unique([requesterId, addresseeId])
  @@index([addresseeId, status])
  @@index([requesterId, status])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String?  @unique
  phone     String?
  avatarUrl String?
  bio       String?

  age    Int?
  gender String?
  goals  String[] @default([])

  interests String[] @default([])
  skills    String[] @default([])
  languages String[] @default([])
  examTargets String[] @default([])
  lookingFor  String[] @default([])
  availability String[] @default([])

  city     String?
  state    String?
  country  String?
  timezone String?

  institutionType   String?
  institutionName   String?
  degree            String?
  branch            String?
  semester          String?
  expectedGraduation String?

  company         String?
  role            String?
  experienceLevel String?
  workMode        String?

  collaborationPreference String?
  dailyStudyGoalMinutes   Int?    @default(0)
  portfolioUrl String?
  linkedinUrl  String?
  githubUrl    String?
  isDiscoverable Boolean @default(true)
  aiMonitorConsent Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([institutionType])
  @@index([institutionName])
}


model Room {
  id     String @id @default(cuid())
  roomId String @unique
  name   String
  description String?     
  tags        String[]

  ownerId   String?
  owner     User?        @relation("UserOwnedRooms", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  visibility  RoomVisibility @default(PRIVATE)

  startTime          DateTime?
  durationMinutes    Int?
  isRecurring        Boolean   @default(false)
  recurrenceType     String?   
  recurrenceEndDate  DateTime?

  femaleOnly            Boolean  @default(false)
  preferredLanguages    String[] @default([])
  collaborationStyle    String   @default("quiet-focus")

  youtubeVideoId    String?
  youtubePlaylistId String?
  videoSummary      String?
  videoSummaryAt    DateTime?

  remindersent Boolean @default(false)

  members  RoomMember[]
  messages Message[]
  pomodoro Pomodoro?

  @@index([ownerId, createdAt])
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [roomId])
  user User @relation(fields: [userId], references: [id])

  @@index([userId, roomId])
}

model Message {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [roomId], onDelete: Cascade)

  @@index([roomId])
}

model Pomodoro {
  id        String   @id @default(cuid())
  roomId    String   @unique
  running   Boolean  @default(false)
  mode      String   @default("work")
  remaining Int      @default(1500)
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [roomId])
}

model RoomAttendance {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  // Room info denormalized here so a user's analytics survive room deletion
  // (session-based, like FocusSession). Intentionally no FK to Room.
  roomName            String?
  roomTags            String[] @default([])
  roomDurationMinutes Int?

  user User @relation(fields: [userId], references: [id])

  @@index([roomId])
}

model FocusSession {
  id        String   @id @default(cuid())
  userId    String
  roomId    String
  roomName  String?

  sessionDate     DateTime @default(now())
  durationMinutes Int      @default(0)

  focusScore      Int @default(0)
  engagementScore Int @default(0)
  distractionCount   Int @default(0)
  offScreenSeconds   Int @default(0)
  highFocusPercent   Int @default(0)
  medFocusPercent    Int @default(0)
  lowFocusPercent    Int @default(0)
  totalSamples       Int @default(0)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sessionDate(sort: Desc)])
  @@index([roomId, sessionDate(sort: Desc)])
}

model Playlist {
  id           String   @id @default(cuid())
  ytPlaylistId String   @unique
  title        String
  channelTitle String?
  thumbnailUrl String?
  videoCount   Int      @default(0)
  cachedAt     DateTime @default(now())

  videos  PlaylistVideo[]
  plan    PlaylistPlan?
  cohorts Cohort[]
}

model PlaylistVideo {
  id           String  @id @default(cuid())
  playlistId   String
  ytVideoId    String
  title        String
  description  String?
  thumbnailUrl String?
  position     Int
  durationSec  Int?

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  @@index([playlistId])
}

model PlaylistPlan {
  id             String   @id @default(cuid())
  playlistId     String   @unique
  difficulty     String
  estimatedHours Float
  curriculum     Json
  roadmap        Json
  generatedAt    DateTime @default(now())

  playlist Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)
}

model Cohort {
  id          String   @id @default(cuid())
  playlistId  String
  name        String
  createdById String
  maxSize     Int      @default(10)
  createdAt   DateTime @default(now())

  // YouTube cohort: shared recurring study room + daily scheduling
  roomId      String?   // the recurring room members enter
  startMode   String?   // "NOW" | "SCHEDULED"
  dailyTime   String?   // daily session time, "HH:MM" (for display)
  startDate   DateTime? // first session date/time

  playlist     Playlist         @relation(fields: [playlistId], references: [id])
  createdBy    User             @relation("UserCreatedCohorts", fields: [createdById], references: [id])
  members      CohortMember[]
  sessions     StudySession[]
  discussions  DiscussionPost[]
  quizAttempts QuizAttempt[]

  @@index([playlistId])
}

model CohortMember {
  id       String   @id @default(cuid())
  cohortId String
  userId   String
  joinedAt DateTime @default(now())
  progress Json     @default("{}")

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation("UserCohorts", fields: [userId], references: [id])

  @@unique([cohortId, userId])
}

model StudySession {
  id          String   @id @default(cuid())
  cohortId    String
  topic       String
  description String?
  scheduledAt DateTime
  roomId      String?
  status      String   @default("SCHEDULED") // SCHEDULED | COMPLETED | POSTPONED
  orderIndex  Int      @default(0)
  studyHours  Float?   // planned study time for the day
  createdAt   DateTime @default(now())

  // Playback for the in-room player: the day's video IDs, and (for a video
  // sliced across days) the time segment + part label like "1/3".
  videoIds    String[] @default([])
  startSec    Int?
  endSec      Int?
  part        String?

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)

  @@index([cohortId])
  @@index([status, scheduledAt])
}

model DiscussionPost {
  id        String   @id @default(cuid())
  cohortId  String
  authorId  String
  content   String
  parentId  String?
  createdAt DateTime @default(now())

  cohort  Cohort           @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  author  User             @relation("UserDiscussions", fields: [authorId], references: [id])
  parent  DiscussionPost?  @relation("Replies", fields: [parentId], references: [id])
  replies DiscussionPost[] @relation("Replies")

  @@index([cohortId, createdAt])
}

model QuizAttempt {
  id          String   @id @default(cuid())
  cohortId    String
  userId      String
  questions   Json
  answers     Json
  score       Int
  completedAt DateTime @default(now())

  cohort Cohort @relation(fields: [cohortId], references: [id], onDelete: Cascade)
  user   User   @relation("UserQuizAttempts", fields: [userId], references: [id])

  @@index([cohortId, userId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  applicationLink String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies CommunityReply[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model CommunityReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}
