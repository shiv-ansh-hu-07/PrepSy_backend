datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id          String   @id @default(cuid())
  name        String?
  email       String   @unique
  password    String?          
  provider    String   @default("local")
  providerId  String?
  loginStreak Int      @default(0)
  lastLoginAt DateTime?
  streakDisabled Boolean @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  roomsOwned  Room[]       @relation("UserOwnedRooms")
  roomMembers RoomMember[]
  attendance  RoomAttendance[]
  communityPosts   CommunityPost[]
  communityReplies CommunityReply[]
  profile UserProfile?

  @@unique([provider, providerId])
}

model UserProfile {
  id        String   @id @default(cuid())
  userId    String   @unique
  username  String?  @unique
  phone     String?
  avatarUrl String?
  bio       String?

  age    Int?
  gender String?
  goals  String[] @default([])

  interests String[] @default([])
  skills    String[] @default([])
  languages String[] @default([])
  examTargets String[] @default([])
  lookingFor  String[] @default([])
  availability String[] @default([])

  city     String?
  state    String?
  country  String?
  timezone String?

  institutionType   String?
  institutionName   String?
  degree            String?
  branch            String?
  semester          String?
  expectedGraduation String?

  company         String?
  role            String?
  experienceLevel String?
  workMode        String?

  collaborationPreference String?
  portfolioUrl String?
  linkedinUrl  String?
  githubUrl    String?
  isDiscoverable Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([city])
  @@index([institutionType])
  @@index([institutionName])
}


model Room {
  id     String @id @default(cuid())
  roomId String @unique
  name   String
  description String?     
  tags        String[]

  ownerId   String?
  owner     User?        @relation("UserOwnedRooms", fields: [ownerId], references: [id])

  createdAt DateTime @default(now())

  visibility  RoomVisibility @default(PRIVATE)

  startTime          DateTime?
  durationMinutes    Int?
  isRecurring        Boolean   @default(false)
  recurrenceType     String?   
  recurrenceEndDate  DateTime?

  femaleOnly         Boolean  @default(false)
  preferredLanguages String[] @default([])

  remindersent Boolean @default(false)

  members  RoomMember[]
  messages Message[]
  pomodoro Pomodoro?
  attendance RoomAttendance[]

  @@index([ownerId, createdAt])
}

enum RoomVisibility {
  PUBLIC
  PRIVATE
}

model RoomMember {
  id       String   @id @default(cuid())
  roomId   String
  userId   String
  joinedAt DateTime @default(now())

  room Room @relation(fields: [roomId], references: [roomId])
  user User @relation(fields: [userId], references: [id])

  @@index([userId, roomId])
}

model Message {
  id         String   @id @default(cuid())
  roomId     String
  senderId   String?
  senderName String?
  text       String
  createdAt  DateTime @default(now())

  room Room @relation(fields: [roomId], references: [roomId], onDelete: Cascade)

  @@index([roomId])
}

model Pomodoro {
  id        String   @id @default(cuid())
  roomId    String   @unique
  running   Boolean  @default(false)
  mode      String   @default("work")
  remaining Int      @default(1500)
  updatedAt DateTime @updatedAt

  room Room @relation(fields: [roomId], references: [roomId])
}

model RoomAttendance {
  id        String   @id @default(cuid())
  roomId    String
  userId    String
  joinedAt  DateTime @default(now())
  leftAt    DateTime?

  room Room @relation(fields: [roomId], references: [roomId])
  user User @relation(fields: [userId], references: [id])

  @@index([roomId])
}

model CommunityPost {
  id        String   @id @default(cuid())
  authorId  String
  title     String
  content   String
  applicationLink String?
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  author  User             @relation(fields: [authorId], references: [id], onDelete: Cascade)
  replies CommunityReply[]

  @@index([createdAt(sort: Desc)])
  @@index([authorId, createdAt(sort: Desc)])
}

model CommunityReply {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  content   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId, createdAt(sort: Desc)])
}
