JWT_SECRET="replace-with-dev-jwt-secret"
PORT=5000

DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE"

LIVEKIT_API_KEY="replace-with-livekit-api-key"
LIVEKIT_API_SECRET="replace-with-livekit-api-secret"
LIVEKIT_WS_URL="wss://your-livekit-instance.livekit.cloud"

# Only the client ID is required — the app verifies Google ID tokens against it
# (verifyIdToken). No client secret is used.
GOOGLE_CLIENT_ID="replace-with-google-client-id"

RESEND_API_KEY="replace-with-resend-api-key"
EMAIL_FROM="noreply@example.com"

# Frontend origin used when building links in emails
FRONTEND_URL="https://prepsy.in"

# External AI service (focus scoring, learn features)
AI_SERVICE_URL="https://your-ai-service.example.com"

# YouTube Data API key for playlist features
YOUTUBE_API_KEY="replace-with-youtube-api-key"

# --- AWS (avatar uploads to S3 + CloudFront) ---
# On EC2/ECS these AWS credentials come from the instance/task IAM role, so
# only AWS_REGION, the bucket, and the CloudFront domain are set here.
AWS_REGION="us-east-1"
# Region of the avatar S3 bucket (can differ from AWS_REGION)
S3_REGION="us-east-1"
S3_BUCKET_NAME="prepsy-avatars-prod"
CLOUDFRONT_DOMAIN="d123abcxyz.cloudfront.net"
